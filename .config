# Target System
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq5018=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq5018_DEVICE_jdc_re_os_03u=y

# Kernel
CONFIG_KERNEL_VERSION="5.4"
CONFIG_KERNEL_TESTING_PATCHES=n

# MMC/eMMC 闪存核心驱动
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLATFORM=y
CONFIG_MMC_SDHCI_QCOM=y
CONFIG_MMC_HS200=y
CONFIG_MMC_18V=y

# 文件系统
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=n
CONFIG_JFFS2_FS=n

# 网络 有线 SSDK 依赖
CONFIG_PACKAGE_kmod-nss-dp=y
CONFIG_PACKAGE_kmod-ssdk=y
CONFIG_PACKAGE_swconfig=n

# 无线 ath11k
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018=y

# 802.11r/k/v 漫游必备
CONFIG_DRIVER_11R_SUPPORT=y
CONFIG_DRIVER_11K_SUPPORT=y
CONFIG_DRIVER_11V_SUPPORT=y

# 认证组件 必须用这个
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-common=y

# 禁用不兼容版本
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-mini is not set

# 基础常用组件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-network=y
CONFIG_PACKAGE_luci-wifi=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
